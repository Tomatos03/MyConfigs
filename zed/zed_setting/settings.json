{
    "status_bar": {
        "active_encoding_button": "enabled"
    },
    "cli_default_open_behavior": "existing_window",
    "proxy": "http://localhost:7890",
    "language_models": {
        "openai_compatible": {
            "MiMo": {
                "api_url": "https://token-plan-cn.xiaomimimo.com/v1",
                "available_models": [
                    {
                        "name": "mimo-v2.5-pro",
                        "max_tokens": 1048576,
                        "max_output_tokens": 131072,
                        "max_completion_tokens": 131072,
                        "capabilities": {
                            "tools": true,
                            "images": true,
                            "parallel_tool_calls": true,
                            "prompt_cache_key": true,
                            "chat_completions": true,
                            "interleaved_reasoning": false
                        }
                    }
                ]
            }
        }
    },
    "git_commit_buffer_font_size": 23,
    "auto_update": false,
    "debugger": {
        "dock": "bottom",
    },
    "diff_view_style": "split",
    "rounded_selection": true,
    "cursor_shape": "bar",
    "buffer_line_height": "comfortable",
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "right",
    },
    "git_panel": {
        "dock": "left",
        "tree_view": true,
    },
    "soft_wrap": "none",
    // ----------- mcp --------
    "preferred_line_length": 90,
    "agent_servers": {
        "pi-acp": {
            "favorite_config_option_values": {
                "thought_level": [
                    "xhigh"
                ]
            },
            "default_config_options": {
                "model": "opencode-go/deepseek-v4-flash",
                "thought_level": "high"
            },
            "type": "registry"
        },
        "github-copilot-cli": {
            "type": "registry"
        },
        "claude-acp": {
            "default_config_options": {
                "effort": "medium",
                "model": "opus",
                "mode": "acceptEdits"
            },
            "favorite_config_option_values": {
                "mode": [
                    "acceptEdits",
                    "plan"
                ],
                "model": [
                    "claude-sonnet-4-6",
                    "opus"
                ]
            },
            "type": "registry",
        },
        "codex-acp": {
            "favorite_config_option_values": {
                "model": ["gpt-5.3-codex"],
            },
            "type": "registry",
        },
        "opencode": {
            "default_config_options": {
                "effort": "max",
                "mode": "plan",
                "model": "opencode-go/mimo-v2.5"
            },
            "favorite_config_option_values": {
                "effort": [
                    "max"
                ],
                "model": [
                    "opencode/minimax-m2.5-free",
                    "opencode-go/mimo-v2.5",
                    "opencode-go/deepseek-v4-flash",
                    "opencode-go/deepseek-v4-pro",
                    "opencode-go/mimo-v2.5-pro"
                ]
            },
            "favorite_models": [
                "opencode/big-pickle/high",
                "opencode/minimax-m2.5-free",
                "github-copilot/claude-haiku-4.5",
                "opencode/big-pickle/max",
                "opencode/mimo-v2-pro-free",
                "opencode/qwen3.6-plus-free",
                "github-copilot/gpt-5-mini",
                "opencode/mimo-v2-omni-free",
            ],
            "type": "registry",
        },
        "github-copilot": {
            "default_model": "gpt-4.1",
            "favorite_models": ["gpt-4.1"],
            "type": "registry",
        },
    },
    "context_servers": {
        "mcp-server-context7": {
            "enabled": true,
            "remote": false,
            "settings": {
                "context7_api_key": "__CONTEXT7_API_KEY__"
            }
        },
        "mcp-server-exa-search": {
            "enabled": true,
            "remote": false,
            "settings": {},
        },
        "mcp-server-github": {
            "enabled": true,
            "settings": {
                "github_personal_access_token": "__GITHUB_TOKEN__",
            },
        },
    },
    // ========================= AI相关 =========================
    "confirm_quit": false,
    "agent_ui_font_size": 23,
    "agent_buffer_font_size": 22,
    "disable_ai": false,
    "agent": {
        "limit_content_width": true,
        "max_content_width": 1200,
        "profiles": {
            "plan": {
                "default_model": {
                    "provider": "copilot_chat",
                    "model": "gpt-4.1",
                    "enable_thinking": false,
                },
                "name": "Plan",
                "tools": {
                    "open": true,
                    "now": true,
                    "fetch": false,
                    "grep": true,
                    "update_plan": true,
                    "spawn_agent": true,
                    "read_file": true,
                    "diagnostics": true,
                },
                "enable_all_context_servers": false,
                "context_servers": {
                    "mcp-server-exa-search": {
                        "tools": {
                            "web_search_exa": true,
                            "web_fetch_exa": true,
                        },
                    },
                },
            },
        },
        "flexible": true,
        "tool_permissions": {
            "tools": {
                "fetch": {
                    "always_allow": [
                        {
                            "pattern": "^https?://docs\\.github\\.com"
                        }
                    ]
                },
                "mcp:mcp-server-github:create_or_update_file": {
                    "default": "allow"
                },
                "terminal": {
                    "default": "allow",
                },
            },
        },
        "default_profile": "write",
        "dock": "right",
        "sidebar_side": "right",
        "default_model": {
            "effort": "high",
            "provider": "deepseek",
            "model": "deepseek-v4-flash",
            "enable_thinking": true,
        },
        "favorite_models": [
            {
                "provider": "copilot_chat",
                "model": "claude-haiku-4.5",
                "enable_thinking": true
            },
            {
                "provider": "copilot_chat",
                "model": "gpt-4.1",
                "enable_thinking": false
            },
            {
                "provider": "copilot_chat",
                "model": "gpt-5-mini",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "copilot_chat",
                "model": "gemini-3-flash-preview",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "copilot_chat",
                "model": "gpt-5.2-codex",
                "enable_thinking": true,
                "effort": "high"
            }
        ],
        "model_parameters": [],
    },

    // ========================= 杂项 =========================
    "sticky_scroll": {
        "enabled": true,
    },
    "languages": {
        "TypeScript": {
            "prettier": { "allowed": false },
        },
    },
    "title_bar": {
        "show_branch_status_icon": true,
    },
    "auto_indent": "syntax_aware",
    "autosave": "on_focus_change",
    "restore_on_file_reopen": true,
    "colorize_brackets": true,
    "format_on_save": "off",
    "tab_size": 4,
    "preview_tabs": {
        "enabled": false, // 关闭后每次打开新文件创建一个新的tab
    },

    // ========================= 关闭匿名数据收集 =========================
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },

    // ========================= 主题相关 =========================
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Catppuccin Macchiato - No Italics"
    },
    "icon_theme": {
        "mode": "light",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme"
    },

    // ========================= Vim相关设置 =========================
    "vim_mode": true,
    "vim": {
        "default_mode": "insert",
        "use_system_clipboard": "always",
        "use_smartcase_find": true,
        "toggle_relative_line_numbers": true,
        "highlight_on_yank_duration": 200,
    },

    // ========================= 代码编辑区 =========================
    "buffer_font_size": 21.0,
    "buffer_font_family": "Fira Code",
    "buffer_font_features": {
        "calt": true, // 连字特性
        "cv01": true, // 字母a
        "cv02": true, // 字母g
        "cv03": true, // 字母i
        "cv07": true, // 字母l
        "cv29": true, // 花括号
        "cv30": true, // 符号|
        "ss03": true, // 符号&
        "ss05": true, // 符号@
    },
    "show_edit_predictions": true,
    "edit_predictions": {
        "provider": "copilot",
        "copilot": {
            "enable_next_edit_suggestions": true,
        },
        "mode": "subtle",
    },
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": false,
        "show_parameter_hints": true,
        "show_other_hints": false,
        "show_background": false,
        "edit_debounce_ms": 700,
        "scroll_debounce_ms": 50,
    },
    "diagnostics": {
        "button": true,
        "inline": {
            "enabled": true,
            "update_debounce_ms": 200,
            "padding": 4,
            "min_column": 0,
            "max_severity": "warning",
        },
    },

    // ========================= FileFinder全局文件搜索 =========================
    "file_finder": {
        "file_icons": true,
        "skip_focus_for_active_in_search": true,
        "modal_max_width": "medium",
    },

    // ========================= UI界面 =========================
    "ui_font_family": ".ZedSans",
    "ui_font_size": 25,

    // ========================= 终端相关 =========================
    "terminal": {
        "dock": "bottom",
        "shell": "system",
        "font_family": "Fira Code",
        "font_size": 25,
    },

    // ========================= 小地图设置 =========================
    "minimap": {
        "show": "auto",
        "display_in": "active_editor",
    },
    // ========================= LSP相关 =========================
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                },
            },
            "enable_lsp_tasks": true,
        },
        "tailwindcss-language-server": {
            "settings": {
                "classFunctions": ["cva", "cx"],
                "experimental": {
                    "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
                },
            },
        },
        "jdtls": {
            "settings": {
                // "java_home": "/usr/lib/jvm/java-25-openjdk/",
                "lombok_support": true,
                "jdk_auto_download": false,

                // Controls when to check for updates for JDTLS, Lombok, and Debugger
                // - "always" (default): Always check for and download the latest version
                // - "once": Check for updates only if no local installation exists
                // - "never": Never check for updates, only use existing local installations (errors if missing)
                //
                // Note: Invalid values will default to "always"
                // If custom paths (below) are provided, check_updates is IGNORED for that component
                "check_updates": "never",

                /*
           Use custom installations instead of managed downloads
           When these are set, the extension will not download or manage these components
           "jdtls_launcher": "/path/to/your/jdt-language-server/bin/jdtls",
           "lombok_jar": "/path/to/your/lombok.jar",
           "java_debug_jar": "/path/to/your/com.microsoft.java.debug.plugin.jar"
         */
            },
        },
    },
}
